{
  "name": "closeguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome MV3 extension whose only job is to press 'close' on interrupting ads and pop-ups.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "package": "node scripts/package.mjs",
    "validate": "npm run lint && npm run typecheck && npm run test:cov && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jsdom": "^31.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
